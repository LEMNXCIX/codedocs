# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

/dist/
/target/

# Cargo.lock is NOT ignored: this is an application, not a library, so the exact
# dependency versions it was built and tested against must be pinned in version
# control. Otherwise two checkouts can resolve to different versions of the same
# crates, which makes "works on my machine" unavoidable.
/Cargo.lock

# Build output, regenerated by the `pre_build` hooks in Trunk.toml:
#   styles.css                      <- tailwindcss
#   public/codemirror-bridge.js     <- esbuild js/codemirror-bridge.mjs
#   public/vendor/preview-bridge.js <- esbuild js/preview-bridge.mjs
# Committing these meant a stale copy could ship instead of the source.
/styles.css
/public/codemirror-bridge.js
/public/vendor/preview-bridge.js

# Vendored third-party assets ARE tracked: they are inputs, not build output.
/public/vendor/katex/
/public/vendor/mermaid/

# Additional common ignores
.DS_Store
Thumbs.db
*.log
*.tmp
.env
node_modules/
.vscode/settings.json
.idea/
# Playwright, used only by the browser checks in scripts/
/test-results/
/playwright-report/

{
  "name": "codedocs",
  "version": "0.1.0",
  "description": "Editor de Markdown de escritorio al estilo Typora, con Tauri 2 y Leptos",
  "scripts": {
    "dev": "trunk serve",
    "tauri": "cargo tauri dev",
    "build": "trunk build --release",
    "test": "cargo test -p codedocs-core",
    "lint": "cargo clippy -p codedocs-core --all-targets -- -D warnings",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "build:cm": "esbuild js/codemirror-bridge.mjs --bundle --format=iife --target=es2020 --outfile=public/codemirror-bridge.js --minify",
    "build:preview": "esbuild js/preview-bridge.mjs --bundle --format=iife --target=es2020 --outfile=public/vendor/preview-bridge.js --minify",
    "check:bridge": "node scripts/check-bridge-contract.mjs",
    "verify": "npm run check:bridge && npm run check:tauri && cargo fmt --all -- --check && npm run lint:core && npm run test:core && npm run test:ui && npm run test:backend && npm run check:frontend && npm run check:backend",
    "lint:core": "cargo clippy -p codedocs-core --all-targets -- -D warnings",
    "lint:backend": "cargo clippy -p codedocs --all-targets -- -D warnings",
    "test:core": "cargo test -p codedocs-core",
    "test:ui": "cargo test -p codedocs-ui",
    "//test:backend": "The path guard is the only thing stopping a write outside the workspace, and the browser checks stub the whole backend — so the guard's rules need a host test that runs in the gate, not one only reachable by hand.",
    "test:backend": "cargo test -p codedocs",
    "check:frontend": "cargo check --target wasm32-unknown-unknown",
    "check:backend": "cargo check -p codedocs",
    "check:tauri": "node scripts/check-tauri-contract.mjs",
    "check:csp": "node scripts/check-csp-boot.cjs",
    "check:preview": "node scripts/check-preview-render.cjs",
    "check:live": "node scripts/check-live-editor.cjs",
    "check:big": "node scripts/check-large-folder.cjs",
    "verify:browser": "npm run build && npm run check:glue && npm run check:csp && npm run check:ipc && npm run check:preview && npm run check:live && npm run check:big",
    "check:glue": "node scripts/check-tauri-glue.mjs",
    "check:ipc": "node scripts/check-ipc-flow.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LEMNXCIX/codedocs.git"
  },
  "keywords": [
    "tauri",
    "leptos",
    "markdown",
    "editor",
    "wysiwyg",
    "tauri-app"
  ],
  "author": "CodeDocs contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LEMNXCIX/codedocs/issues"
  },
  "homepage": "https://github.com/LEMNXCIX/codedocs#readme",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.28.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0"
  }
}
